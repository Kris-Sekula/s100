@@ -1335,6 +1369,38 @@ settrack0:
    RET
 #endif
 
+      // --- True-activity LED helpers (patch) ---
+      // Leaf routines: clobber r0/r1 only, call no other routine.
+      // All call sites are in top-level flow (branched/fallen into,
+      // never inside another CALLed routine), so r29 is free.
+      //
+      // Activity events: (re)selection / head change (via selected:),
+      // a step pulse (via step:), and write gate (via write:).
+      // ST-506/MFM has no read gate from the controller, so a pure
+      // streaming read with no control-line change cannot be told
+      // apart from idle spinning -- see act_tick.
+act_event:
+   QBEQ     act_event_ret, ACT_LED_MASK, 0   // No drive, nothing to light
+   MOV      ACT_TICKS, ACT_HOLD_TICKS        // (Re)start the hold timer
+   MOV      r0, ACT_LED_MASK
+   MOV      r1, GPIO0 | GPIO_CLEARDATAOUT    // Active low: on
+   SBBO     r0, r1, 0, 4
+act_event_ret:
+   RET
+
+      // Called once per revolution from end_track. While a write or a
+      // seek is in progress end_track is not reached, so the LED simply
+      // stays on for the duration -- which is the desired behaviour.
+act_tick:
+   QBEQ     act_tick_ret, ACT_TICKS, 0
+   SUB      ACT_TICKS, ACT_TICKS, 1
+   QBNE     act_tick_ret, ACT_TICKS, 0
+   MOV      r0, (1 << GPIO0_DRIVE0_LED) | (1 << GPIO0_DRIVE1_LED)
+   MOV      r1, GPIO0 | GPIO_SETDATAOUT      // Active low: both off
+   SBBO     r0, r1, 0, 4
+act_tick_ret:
+   RET
+
 // Get select and head value
 // Returns PRU0_CUR_SELECT_HEAD in r24. For REVC PRU0_CUR_SELECT_HEAD is
 // only head. Select written to PRU0_R31. PRU0_CUR_HEAD also updated with
@@ -1375,6 +1441,10 @@ storeh1:
       // Capture write data from the controller.
       // We switch the ECAP from PWM mode to capture mode
 write:
+   CALL     act_event             // activity patch: write gate active.
+                                  // LED then stays on for the whole write:
+                                  // act_tick only runs at end_track, which
+                                  // the write capture loop never reaches.
    XOUT     10, TRACK_BIT, 4        // Send current bit count.
 SBCO TRACK_BIT, CONST_PRURAM, 0xe0, 4
 LBBO     r0, CYCLE_CNTR, 0, 4     // Get time

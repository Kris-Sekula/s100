+   // --- True-activity LED patch (not in upstream) ---
+   // r6/r7/r13/r14/r15 are unused elsewhere in this file (verified by
+   // grep). r13/r14 hold the activity-LED state:
+   // ACT_TICKS: revolutions remaining before the LED is turned off.
+   //   Counted down once per revolution at end_track. Not a wall-clock
+   //   timer on purpose: both the cycle counter and the IEP counter are
+   //   reset by the seek/read/write paths, so neither is a free-running
+   //   clock. One revolution is 16.7 ms at 3600 RPM, 20 ms at 3000 RPM.
+   // ACT_LED_MASK: GPIO0 bit of the currently selected drive's LED
+   //   (1 << GPIO0_DRIVE0_LED or 1 << GPIO0_DRIVE1_LED), 0 = none.
+#define ACT_TICKS    r13
+#define ACT_LED_MASK r14
+   // Hold time in revolutions after the last activity event.
+   // 6 = ~100 ms at 3600 RPM, ~120 ms at 3000 RPM.
+#define ACT_HOLD_TICKS 6
+
    // 100 nanoseconds, Settle time for head/select lines after change
 #define SETTLE_TIME 20
